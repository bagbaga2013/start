<odoo>
    <data>

        <record id="view_hotel_room_tree" model="ir.ui.view">
            <field name="name">hotel.tag.tree</field>
            <field name="model">my.tag</field>
            <field name="arch" type="xml">
                <tree delete="0" create="1" edit="0" class="custom">
                    <field name="namee"/>
                    <field name="test1"/>
                    
                </tree>
            </field>
        </record>

        <record id="view_hotel_room_form" model="ir.ui.view">
            <field name="name">hotel.tag.form</field>
            <field name="model">my.tag</field>
            <field name="arch" type="xml">
                <form  >
                    <sheet>
                    <header>
                      
                    </header>
                        <group>
                              <field name="namee"/>
                    <field name="test1"/>
                            
                        </group>
                    </sheet>
                </form>
            </field>
        </record>





        <record id="action_my_tag" model="ir.actions.act_window">
            <field name="name">tag</field>
            <field name="res_model">my.tag</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
