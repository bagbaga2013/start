<template id="users_page" name="Users Page">
    <t t-call="website.layout">
        <div class="container mt-4" dir="rtl">
            <h2>قائمة المستخدمين</h2>

            <table class="table table-bordered table-hover mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>الاسم</th>
                        <th>البريد الإلكتروني</th>
                        <th>الجنس</th>
                        <th>الحالة</th>
                        <th>تعديل</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="users" t-as="user">
                        <tr>
                            <td t-esc="user.get('name', '')"/>
                            <td t-esc="user.get('email', '')"/>
                            <td t-esc="user.get('gender', '')"/>
                            <td>
                                <span t-if="user.get('status') == 'active'"
                                    class="badge bg-success">نشط</span>
                                <span t-else="" 
                                    class="badge bg-secondary">غير نشط</span>
                            </td>
                            <td>
                                <a t-attf-href="/users/edit/#{user.get('id')}"
                                class="btn btn-sm btn-warning">
                                    تعديل
                                </a>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>
</template>