<odoo>
    <data>

        <record id="view_my_hotel_tree" model="ir.ui.view">
            <field name="name">my.hotel.tree</field>
            <field name="model">hotel.room</field>
            <field name="arch" type="xml">
                <tree delete="0" create="1" edit="0"  >
                    <field name="name"/>
                    <field name="room_type"/>
                    <field name="price"/>
                     <field name="t1"/>
                    <field name="idmyroom"/>
                    <field name="active"/>

                    <field name="is_available"  optional="1"/>
                </tree>
            </field>
        </record>

        <record id="view_hotel_room_form" model="ir.ui.view">
            <field name="name">hotel.room.form</field>
            <field name="model">hotel.room</field>
            <field name="arch" type="xml">
                <form  >
                    <sheet>
                    <header>
                      <field name="room_type" widget="statusbar" clickable="1" options="{'clickable':1}"/>
                    </header>
                        <group>
                             <field name="hotel_id"/>  
                            <field name="name"/>
                            <field name="room_type"/>
                            <field name="price"/>
                             <field name="t1"/>
                             <field name="active"/>
                             
                        </group>
                    </sheet>
                    <div>
                    </div>
                </form>
            </field>
        </record>


<record id="view_name_inherit" model="ir.ui.view">
    <field name="name">model.view.inherit</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <field name="partner_id" position="after">
          <!-- <field name="namee"/> -->
        </field>
    </field>
</record>


        <record id="action_hotel_room" model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="res_model">hotel.room</field>
            <field name="view_mode">tree,form</field>
        </record>


 
    </data>
</odoo>
